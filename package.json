{
  "name": "dsh-memory-curve",
  "version": "0.5.2",
  "description": "按艾宾浩斯遗忘曲线给记忆事件分级：高留存的进上下文，低留存的只留文件。上千条对话压成几百字索引，完整记忆仍在磁盘上按需反查。",
  "type": "module",
  "license": "MIT",
  "author": "simplifyeverythingabc",
  "homepage": "https://github.com/simplifyeverythingabc/dsh-memory-curve#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simplifyeverythingabc/dsh-memory-curve.git"
  },
  "bugs": {
    "url": "https://github.com/simplifyeverythingabc/dsh-memory-curve/issues"
  },
  "exports": {
    ".": "./src/index.js",
    "./events": "./src/events.js",
    "./digest": "./src/digest.js",
    "./paths": "./src/paths.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./src/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "memory",
    "ebbinghaus",
    "forgetting-curve",
    "context-management",
    "agent-memory"
  ],
  "dsh-plugin": {
    "category": "memory",
    "displayName": "记忆事件分级（遗忘曲线）"
  },
  "engines": {
    "node": ">=22.15.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "scripts": {
    "check": "node tools/check.mjs",
    "verify": "node tools/verify-ids.mjs",
    "verify:strict": "node tools/verify-ids.mjs --strict",
    "selftest": "node tools/selftest.mjs",
    "test:collector": "node --test tools/collector-test.mjs tools/collector-host-test.mjs",
    "collect": "node tools/memory-notes.mjs",
    "build": "node tools/build-dailies.mjs"
  }
}
